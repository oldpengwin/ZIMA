# ─────────────────────────────────────────────────────────────
# ZIMA DEMO — environment variables
# Copy this file to ".env" and fill in every value.
# Never commit the real .env (it's already in .gitignore).
# ─────────────────────────────────────────────────────────────

# --- Discord ---
# Developer Portal → your app → Bot → Reset Token → copy
DISCORD_TOKEN=

# Developer Portal → General Information → Application ID
DISCORD_APPLICATION_ID=

# Your server icon → Copy Server ID (turn on Developer Mode first).
# Optional, but makes slash commands appear instantly instead of ~1 hour.
DISCORD_SERVER_ID=

# Right-click your onboarding channel → Copy Channel ID
ONBOARDING_CHANNEL_ID=

# Server Settings → Roles → your "Vetted" role → Copy Role ID
VETTED_ROLE_ID=

# --- Supabase ---
# Supabase → Project Settings → API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API → service_role key (NOT the anon key).
# Server-side only. Treat it like a password.
SUPABASE_SERVICE_ROLE_KEY=
