# Discord Bot Dockerfile
#
# Builds the REAL bot — discord.js, repo root (src/index.js, package.json).
# The previous dead, unwired second Discord bot (a Python discord.py cog at
# src/bot/cogs/matching.py, with no package.json/index.js of its own) has
# since been deleted outright — there's only one bot now.
#
# 13-Aug-2026 production audit: this file previously had
# `COPY src/db/supabase.js ./src/db/supabase.js`, which does not exist —
# the bot no longer talks to Supabase directly (writes go through the Python
# API via src/lib/apiClient.js, see src/config.js). That line would have
# failed `docker build` outright the first time this was actually built, so
# it's replaced with the real runtime dependency (src/lib/) here.

FROM node:18-alpine

ENV NODE_ENV=production

WORKDIR /app

# Install dependencies first (better layer caching than copying source first).
COPY package*.json ./
RUN npm ci --omit=dev

# Copy only what the bot actually needs at runtime — not migrations/, tests/,
# the Python backend, or the frontend.
COPY src/config.js ./src/config.js
COPY src/index.js ./src/index.js
COPY src/register-commands.js ./src/register-commands.js
COPY src/lib ./src/lib
COPY src/features ./src/features
COPY src/handlers ./src/handlers
COPY src/roles ./src/roles

# Runs as the non-root `node` user the base image already provides —
# no extra RUN useradd needed.
USER node

CMD ["node", "src/index.js"]
