# ZIMA Platform - Environment Configuration

# ============================================
# BACKEND CONFIGURATION
# ============================================

# Database
# Host is "localhost" for running the API directly on your machine against
# a local/manually-run Postgres. Running via `docker compose up` instead?
# Change the host to "db" (the compose service name, resolvable only inside
# the compose network) — e.g.
#   DATABASE_URL=postgresql://zima_user:zima_password@db:5432/zima
# "localhost" inside the api container means the container itself, not the
# db container, and the connection will just fail.
DATABASE_URL=postgresql://zima_user:zima_password@localhost:5432/zima

# JWT Authentication
SECRET_KEY=change-this-to-a-strong-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Discord OAuth2
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:8000/api/v1/auth/discord/callback
DISCORD_BOT_TOKEN=your-discord-bot-token

# LLM Configuration
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Redis
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=15

# CORS
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# CORS - Comma separated list of allowed origins
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# The React SPA (src/frontend, Vite) reads these — put them in
# src/frontend/.env (or the host's env), not this backend .env:
#   VITE_API_URL   = https://api.zima.example   (prod API origin; empty in dev, Vite proxies /api)
#   VITE_API_PROXY = http://localhost:8000       (dev-only proxy target)

# FRONTEND_URL (BACKEND setting): where the Discord OAuth2 callback redirects
# back to after login, with the token in the URL fragment. Set this to the
# deployed frontend origin. If empty, the callback returns JSON instead.
FRONTEND_URL=http://localhost:3000

# ============================================
# DISCORD BOT CONFIGURATION
# ============================================

# Discord API
DISCORD_TOKEN=your-discord-bot-token-here
DISCORD_APPLICATION_ID=your-application-id
DISCORD_SERVER_ID=your-server-id

# Channel and Role IDs
ONBOARDING_CHANNEL_ID=your-onboarding-channel-id
VETTED_ROLE_ID=your-vetted-role-id

# Supabase (for bot database)
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Neurotype typology quiz — the bot calls the Python API for scoring.
# API_BASE_URL: where the FastAPI backend is reachable from the bot.
# BOT_API_KEY: shared service key for the bot -> API path. Set the SAME value
#   as BOT_API_KEY on the backend (below); the backend compares it in constant
#   time and rejects everyone if it's unset.
API_BASE_URL=http://localhost:8000
BOT_API_KEY=change-me-to-a-long-random-shared-secret

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL
POSTGRES_USER=zima
POSTGRES_PASSWORD=zima_password
POSTGRES_DB=zima
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# DOCKER CONFIGURATION
# ============================================

# Docker Compose
COMPOSE_PROJECT_NAME=zima

# ============================================
# PRODUCTION CONFIGURATION
# ============================================

# Environment
# ENVIRONMENT is what src/core/config.py reads (falls back to NODE_ENV if unset).
# Set to "production" to enable strict config validation (required SECRET_KEY,
# DATABASE_URL, etc.) and to disable the /api/v1/auth/dev-token backdoor.
ENVIRONMENT=development
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=15

# ============================================
# SECURITY CONFIGURATION
# ============================================

# HTTPS
FORCE_HTTPS=false

# CORS
CORS_ALLOW_CREDENTIALS=true

# CSRF
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_HTTPONLY=true

# ============================================
# INSTRUCTIONS
# ============================================

# 1. Copy this file to .env
#    cp .env.example .env

# 2. Update all the values with your actual configuration

# 3. For production:
#    - Set NODE_ENV=production
#    - Set FORCE_HTTPS=true
#    - Generate a strong SECRET_KEY
#    - Use proper database credentials
#    - Configure proper CORS origins

# 4. Never commit your .env file to version control
